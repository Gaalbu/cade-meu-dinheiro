# PostgreSQL do Supabase (use a URL com pooler na Vercel)
DATABASE_URL="postgresql://postgres.PROJECT:password@host:6543/postgres?pgbouncer=true"
# Conexao direta, usada pelas migrations do Prisma
DIRECT_URL="postgresql://postgres.PROJECT:password@host:5432/postgres"

# Project Settings > API, no painel Supabase
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Pepper do hash dos tokens; gere com: openssl rand -hex 32
WEBHOOK_SECRET="replace-with-at-least-32-random-characters"

# URL publica sem barra final (local: http://localhost:3000)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
