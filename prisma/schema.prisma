generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TransactionType {
  EXPENSE
  INCOME
}

enum TransactionSource {
  MANUAL
  WEBHOOK
  CSV
  OFX
}

enum GoalStatus {
  ACTIVE
  ACHIEVED
  PAUSED
}

model User {
  id            String         @id @db.Uuid
  email         String         @unique
  displayName   String?
  currency      String         @default("BRL")
  timezone      String         @default("America/Bahia")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  categories    Category[]
  transactions  Transaction[]
  budgets       Budget[]
  goals         Goal[]
  webhookTokens WebhookToken[]
  rules         CategoryRule[]
}

model Category {
  id           String         @id @default(uuid()) @db.Uuid
  userId       String         @db.Uuid
  name         String
  slug         String
  color        String
  glyph        String
  position     Int            @default(0)
  createdAt    DateTime       @default(now())
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]
  rules        CategoryRule[]

  @@unique([userId, slug])
  @@index([userId])
}

model CategoryRule {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  categoryId String   @db.Uuid
  keyword    String
  priority   Int      @default(0)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, keyword])
  @@index([userId, priority])
}

model Transaction {
  id                String            @id @default(uuid()) @db.Uuid
  userId            String            @db.Uuid
  categoryId        String            @db.Uuid
  type              TransactionType   @default(EXPENSE)
  source            TransactionSource @default(MANUAL)
  amount            Decimal           @db.Decimal(12, 2)
  merchant          String
  description       String?
  transactedAt      DateTime
  rawNotification   String?
  importFingerprint String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  category          Category          @relation(fields: [categoryId], references: [id])

  @@unique([userId, importFingerprint])
  @@index([userId, transactedAt])
  @@index([userId, merchant])
}

model Budget {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  categoryId String   @db.Uuid
  month      DateTime @db.Date
  limit      Decimal  @db.Decimal(12, 2)
  alertAt    Int      @default(80)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, month])
  @@index([userId, month])
}

model Goal {
  id            String     @id @default(uuid()) @db.Uuid
  userId        String     @db.Uuid
  title         String
  targetAmount  Decimal    @db.Decimal(12, 2)
  currentAmount Decimal    @default(0) @db.Decimal(12, 2)
  deadline      DateTime?  @db.Date
  status        GoalStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model WebhookToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  name       String    @default("Celular principal")
  tokenHash  String    @unique
  tokenPrefix String
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}
